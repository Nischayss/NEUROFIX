    <!-- Vault Block Screen -->
    <string name="vault_block_title">Take a pause.</string>
    <string name="vault_block_body">The app you\'re trying to open is currently in your Vault.</string>
    <string name="vault_block_return_button">Return to NeuroFix</string>

    <!-- Vault Enforcement Notification (Mode 2) -->
    <string name="vault_notification_channel_name">Vault Enforcement</string>
    <string name="vault_notification_title">NeuroFix blocked this app</string>
