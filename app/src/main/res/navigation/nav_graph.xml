<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/onboardingWelcomeFragment">

    <fragment
        android:id="@+id/onboardingWelcomeFragment"
        android:name="com.neurofix.app.presentation.onboarding.OnboardingWelcomeFragment"
        android:label="Welcome"
        tools:layout="@layout/fragment_onboarding_welcome">
        <action
            android:id="@+id/action_welcome_to_permissions"
            app:destination="@id/onboardingPermissionsFragment" />
    </fragment>

    <fragment
        android:id="@+id/onboardingPermissionsFragment"
        android:name="com.neurofix.app.presentation.onboarding.OnboardingPermissionsFragment"
        android:label="Permissions"
        tools:layout="@layout/fragment_onboarding_permissions">
        <action
            android:id="@+id/action_permissions_to_app_selection"
            app:destination="@id/onboardingAppSelectionFragment" />
    </fragment>

    <fragment
        android:id="@+id/onboardingAppSelectionFragment"
        android:name="com.neurofix.app.presentation.onboarding.OnboardingAppSelectionFragment"
        android:label="Select Apps"
        tools:layout="@layout/fragment_onboarding_app_selection">
        <action
            android:id="@+id/action_app_selection_to_dashboard"
            app:destination="@id/dashboardPlaceholderFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardPlaceholderFragment"
        android:name="com.neurofix.app.presentation.dashboard.DashboardPlaceholderFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard_placeholder" />

    <!--
        Vault, Focus Modes, Scheduling, Emergency Session, Statistics, and
        Settings destinations are added here one feature at a time, per the
        approved development workflow.
    -->

</navigation>
