<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        PACKAGE_USAGE_STATS is a special app op, not a runtime permission —
        it must be declared here, but is actually granted via
        Settings.ACTION_USAGE_ACCESS_SETTINGS, guided by the Onboarding
        Permissions screen. tools:ignore suppresses the "protected
        permission" lint warning, which is expected for this permission type.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".NeuroFixApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.NeuroFix"
        android:supportsRtl="true">

        <activity
            android:name=".presentation.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NeuroFix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            android:permission=BIND_ACCESSIBILITY_SERVICE is required by the
            OS so only the system can bind this service — without it, any
            app could impersonate an accessibility service. The grant itself
            still happens through user-facing Settings, guided in Onboarding.
        -->
        <service
            android:name=".services.VaultAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
