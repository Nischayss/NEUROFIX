<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        PACKAGE_USAGE_STATS is a special app op, not a runtime permission —
        it must be declared here, but is actually granted via
        Settings.ACTION_USAGE_ACCESS_SETTINGS, guided by the Onboarding
        Permissions screen. tools:ignore suppresses the "protected
        permission" lint warning, which is expected for this permission type.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Required only to show the optional Step 8 "explanation" notification
        (Mode 2). Enforcement itself (GLOBAL_ACTION_HOME) never depends on
        this — declined/absent permission only means the explanation isn't
        shown, never that a vaulted app fails to be blocked.
    -->
    // minimal replacement code
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".NeuroFixApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.NeuroFix"
        android:supportsRtl="true">

        <activity
            android:name=".presentation.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NeuroFix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The Vault Screen shown over a blocked app. exported=false: only
            NeuroFix itself ever launches it. launchMode=singleTask prevents
            a stack of duplicate blocking screens from rapid repeated
            accessibility events for the same package. excludeFromRecents:
            it's a transient enforcement screen, not a real destination the
            user should find lingering in their recent-apps list.
        -->
        <activity
            android:name=".presentation.vault.VaultBlockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.NeuroFix" />

        <!--
            android:permission=BIND_ACCESSIBILITY_SERVICE is required by the
            OS so only the system can bind this service — without it, any
            app could impersonate an accessibility service. The grant itself
            still happens through user-facing Settings, guided in Onboarding.
        -->
        <service
            android:name=".services.VaultAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
